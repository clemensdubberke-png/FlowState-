<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Gespraechskompass" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/gk_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Startbildschirm (Android-12-Splash-API, rückwärtskompatibel über core-splashscreen) -->
    <style name="Theme.Gespraechskompass.Splash" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/gk_background</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/gk_icon_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Gespraechskompass</item>
    </style>
</resources>
